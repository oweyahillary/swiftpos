# SwiftPOS backend (apps/server) — local development environment.
# Copy to .env and fill in. lib/env.ts validates the required set at boot and
# prints every missing variable at once. For DEPLOYMENT the source of truth is
# render.yaml, which documents boot-blocking vs optional per variable.

# ── Required to boot (all environments) ──────────────────────────────────────
PORT=4000
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Min 16 chars each. Generate: openssl rand -hex 32
JWT_SECRET=your_swiftpos_jwt_secret
ADMIN_JWT_SECRET=your_admin_jwt_secret
# First admin login (fresh deploy only — on a server move the admin already
# exists in the DB). Not stored here; create it by running the CLI with the
# password passed inline:
#   ADMIN_PASSWORD='<strong-password>' npx tsx src/scripts/reset-admin.ts
# (Optional ADMIN_EMAIL overrides the default admin@swiftpos.co.ke.)

# ── Required in production (NODE_ENV=production); optional for local dev ───────
# Ed25519 keypair for tech-access / device-enrolment tokens. In production the
# server refuses to start without them (no ephemeral fallback). PEM newlines as
# literal \n. Generate:
#   openssl genpkey -algorithm ed25519 -out tech_priv.pem
#   openssl pkey -in tech_priv.pem -pubout -out tech_pub.pem
#   sed ':a;N;$!ba;s/\n/\\n/g' tech_priv.pem   # -> the single-line value to paste
TECH_SIGNING_PRIVATE_KEY=
TECH_SIGNING_PUBLIC_KEY=
# Exactly "sandbox" or "production". Required in production (no default there):
# an unset value used to mean sandbox AND disabled the M-Pesa callback IP
# allowlist. Locally you may leave it as sandbox.
MPESA_ENVIRONMENT=sandbox

# ── Supabase auth (part of your Supabase project) ────────────────────────────
SUPABASE_ANON_KEY=your_supabase_anon_key
# Supabase dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ── Strongly recommended ─────────────────────────────────────────────────────
# AES-256-GCM key for at-rest encryption of stored per-business secrets (M-Pesa
# consumer_secret/passkey, eTIMS cmc_key, webhook secrets). 32 bytes as hex:
# openssl rand -hex 32. Without it those saves/reads fail closed.
# NOTE: on a server move this MUST match the old host, or stored credentials
# become permanently undecryptable.
APP_ENCRYPTION_KEY=your_32_byte_encryption_key_as_hex
# Browser origins allowed to call the API (dashboard + admin). Unset falls back
# to a built-in default.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Owner dashboard base URL (used to build links, e.g. in emails).
DASHBOARD_URL=http://localhost:5173
# Public HTTPS base URL Safaricom posts M-Pesa callbacks to (your backend URL).
MPESA_CALLBACK_BASE_URL=

# ── Mail — optional; unset disables outbound mail. Resend first, else SMTP. ───
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM_EMAIL=

# ── Optional / feature-gated (sensible defaults apply if unset) ──────────────
# M-Pesa callback IP allowlist; unset = built-in Daraja ranges.
# MPESA_ALLOWED_IPS=
# Manual discount ceiling percent; default 10.
# MAX_DISCOUNT_PCT=10
# Background job cron schedules; defaults shown.
# DAILY_SUMMARY_CRON=*/15 * * * *
# ETIMS_RETRY_CRON=*/15 * * * *
# eTIMS / KRA fiscalisation; "none" disables it (default). Fill the rest only
# for a real provider.
ETIMS_PROVIDER=none
# ETIMS_BASE_URL=
# ETIMS_AUTH_TOKEN=
# ETIMS_INIT_PATH=
# ETIMS_SALES_PATH=
# ETIMS_QR_BASE=
# WhatsApp / Twilio; "none" disables (default). Out of pilot scope.
# WHATSAPP_PROVIDER=none
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_PHONE_ID=
# WHATSAPP_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# NODE_ENV: "production" on a live host; unset/development locally.
# NODE_ENV=development

# DEPRECATED — do not set. TECH_HMAC_SECRET was retired (audit A113); tech
# tokens are now Ed25519 (v2) and no HMAC secret is read.
