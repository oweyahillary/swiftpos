PORT=4000
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Found in Supabase dashboard → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
JWT_SECRET=your_swiftpos_jwt_secret
ADMIN_JWT_SECRET=your_admin_jwt_secret
TECH_HMAC_SECRET=your_tech_hmac_secret
# AES-256-GCM key for at-rest encryption of stored secrets (eTIMS cmc_key,
# M-Pesa consumer_secret/passkey, webhook signing_secret — see lib/crypto.ts).
# 32 bytes as 64 hex chars, e.g.: openssl rand -hex 32
# Missing this makes encryptSecret() throw (fails closed, by design) — that
# was the actual cause of eTIMS credential saves failing before this fix.
APP_ENCRYPTION_KEY=your_32_byte_encryption_key_as_hex
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RESEND_API_KEY=your_resend_api_key
