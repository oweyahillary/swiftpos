{
  "name": "desktop",
  "version": "0.5.38",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"tsc -p tsconfig.main.json --watch\" \"vite\" \"wait-on http://localhost:5174 dist/main/index.js && electron .\"",
    "build": "tsc -p tsconfig.json && tsc -b tsconfig.main.json && vite build && electron-builder",
    "build:renderer": "vite build",
    "lint": "echo 'lint desktop'",
    "type-check": "tsc --noEmit",
    "build:main": "tsc -b tsconfig.main.json --force",
    "postinstall": "electron-builder install-app-deps",
    "pack:dir": "electron-builder --dir --config.directories.output=build-out",
    "pack:installer": "electron-builder --win nsis --config electron-builder.config.js --config.directories.output=release",
    "pack:portable": "electron-builder --win portable --config electron-builder.config.js --config.directories.output=release",
    "pack:lowmem": "electron-builder --win nsis --config.directories.output=release --config.compression=store",
    "build:all": "npm run clean && npm run build:main && npm run build:renderer",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "assert:built": "node scripts/assert-built.mjs",
    "dist": "npm run assert:built && npm run pack:installer && npm run pack:portable",
    "release:patch": "npm run version:patch && npm run build:all && npm run dist",
    "release:patch:dev": "node scripts/release-flavour.mjs dev patch",
    "release:minor": "npm run version:minor && npm run build:all && npm run dist",
    "release:minor:dev": "node scripts/release-flavour.mjs dev minor",
    "release:major": "npm run version:major && npm run build:all && npm run dist",
    "release:major:dev": "node scripts/release-flavour.mjs dev major",
    "release:both": "node scripts/release-both.mjs",
    "pack:both": "node scripts/release-both.mjs none",
    "pack:dev": "node scripts/release-flavour.mjs dev none",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:held": "node test/heldOrders.test.mjs",
    "test:held:electron": "node test/run-under-electron.mjs test/heldOrders.test.mjs",
    "test:log": "node test/logFile.test.mjs",
    "test:sync": "node test/syncEngine-failures.test.mjs",
    "test:refbundle": "node test/node-reference-bundle.test.mjs",
    "test:refunpack": "node test/node-reference-unpack.test.mjs",
    "test:peerrelay": "node test/peer-relay.test.mjs",
    "test:roster": "node test/roster-snapshot.test.mjs",
    "test:failover": "node test/failover-cursors.test.mjs",
    "test:managefetch": "node test/manage-fetch-refresh.test.mjs",
    "test:devicetoken": "node test/device-token-refresh.test.mjs",
    "test:idlelock": "node test/idle-lock.test.mjs",
    "test:failover:electron": "node test/run-under-electron.mjs test/failover-cursors.test.mjs",
    "test:desktop": "npx tsc -b tsconfig.main.json --force && npm run test:log && npm run test:sync && npm run test:synctimeout && npm run test:syncdecouple && npm run test:expenseid && npm run test:order409 && npm run test:macfp && npm run test:refbundle && npm run test:refunpack && npm run test:peerrelay && npm run test:roster && npm run test:held:electron && npm run test:pin:electron && npm run test:token:electron && npm run test:failover:electron && npm run test:managefetch && npm run test:devicetoken && npm run test:idlelock",
    "test:pin": "node test/pinCache.test.mjs",
    "test:pin:electron": "node test/run-under-electron.mjs test/pinCache.test.mjs",
    "test:token": "node test/tokenStore.test.mjs",
    "test:token:electron": "node test/run-under-electron.mjs test/tokenStore.test.mjs",
    "test:synctimeout": "node test/sync-timeout.test.mjs",
    "test:syncdecouple": "node test/sync-decouple.test.mjs",
    "test:expenseid": "node test/expense-id-repair.test.mjs",
    "test:order409": "node test/order-409-not-synced.test.mjs",
    "test:macfp": "node test/machine-fingerprint.test.mjs"
  },
  "dependencies": {
    "@swiftpos/printing": "file:../../shared/printing",
    "@types/node": "^20.19.43",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "exceljs": "^4.4.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "43.4.0",
    "electron-builder": "^26.15.7",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "wait-on": "^8.0.3"
  },
  "description": "SwiftPOS offline-first point of sale terminal",
  "author": "SwiftPOS",
  "productName": "SwiftPOS",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
