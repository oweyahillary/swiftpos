{
  "name": "desktop",
  "version": "0.5.27",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"tsc -p tsconfig.main.json --watch\" \"vite\" \"wait-on http://localhost:5174 dist/main/index.js && electron .\"",
    "build": "tsc -p tsconfig.json && tsc -b tsconfig.main.json && vite build && electron-builder",
    "build:renderer": "vite build",
    "lint": "echo 'lint desktop'",
    "type-check": "tsc --noEmit",
    "build:main": "tsc -b tsconfig.main.json --force",
    "postinstall": "electron-builder install-app-deps",
    "pack:dir": "electron-builder --dir --config.directories.output=build-out",
    "pack:installer": "electron-builder --win nsis --config.directories.output=release",
    "pack:portable": "electron-builder --win portable --config.directories.output=release",
    "pack:lowmem": "electron-builder --win nsis --config.directories.output=release --config.compression=store",
    "build:all": "npm run clean && npm run build:main && npm run build:renderer",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "assert:built": "node scripts/assert-built.mjs",
    "dist": "npm run assert:built && npm run pack:installer && npm run pack:portable",
    "release:patch": "npm run version:patch && npm run build:all && npm run dist",
    "release:minor": "npm run version:minor && npm run build:all && npm run dist",
    "release:major": "npm run version:major && npm run build:all && npm run dist",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:held": "node test/heldOrders.test.mjs",
    "test:held:electron": "node test/run-under-electron.mjs test/heldOrders.test.mjs",
    "test:log": "node test/logFile.test.mjs",
    "test:sync": "node test/syncEngine-failures.test.mjs",
    "test:failover": "node test/failover-cursors.test.mjs",
    "test:failover:electron": "node test/run-under-electron.mjs test/failover-cursors.test.mjs",
    "test:desktop": "npx tsc -b tsconfig.main.json --force && npm run test:log && npm run test:sync && npm run test:held:electron && npm run test:pin:electron && npm run test:token:electron && npm run test:failover:electron",
    "test:pin": "node test/pinCache.test.mjs",
    "test:pin:electron": "node test/run-under-electron.mjs test/pinCache.test.mjs",
    "test:token": "node test/tokenStore.test.mjs",
    "test:token:electron": "node test/run-under-electron.mjs test/tokenStore.test.mjs"
  },
  "dependencies": {
    "@swiftpos/printing": "file:../../shared/printing",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "exceljs": "^4.4.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "35.7.5",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.swiftpos.desktop",
    "productName": "SwiftPOS",
    "directories": {
      "output": "release"
    },
    "compression": "normal",
    "files": [
      "dist/**/*",
      "resources/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.md",
      "!**/{test,__tests__,tests,powered-test,example,examples}/**",
      "!**/{.eslintrc,.prettierrc,.editorconfig,tsconfig.json,.npmignore}",
      "!node_modules/exceljs/dist/**",
      "!node_modules/better-sqlite3/{src,deps,build/Release/obj,build/Release/obj.target}/**",
      "!node_modules/better-sqlite3/build/**/*.{o,a,lib,exp,pdb,ilk}"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SwiftPOS",
      "include": "build/installer.nsh",
      "allowElevation": true
    },
    "portable": {
      "artifactName": "SwiftPOS-${version}-portable.exe"
    },
    "electronLanguages": [
      "en-US"
    ]
  },
  "description": "SwiftPOS offline-first point of sale terminal",
  "author": "SwiftPOS",
  "productName": "SwiftPOS"
}
