{
  "name": "desktop",
  "version": "1.0.22",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"tsc -b tsconfig.main.json --watch\" \"vite\" \"wait-on http://localhost:5174 dist/main/index.js && electron .\"",
    "build": "tsc -p tsconfig.json && tsc -b tsconfig.main.json && vite build && electron-builder",
    "build:renderer": "vite build",
    "lint": "echo 'lint desktop'",
    "type-check": "tsc --noEmit",
    "build:main": "tsc -b tsconfig.main.json --force",
    "postinstall": "electron-builder install-app-deps",
    "pack:dir": "electron-builder --dir --config.directories.output=build-out",
    "pack:installer": "electron-builder --win nsis --x64 --ia32 --config electron-builder.config.js --config.directories.output=release",
    "pack:portable": "electron-builder --win portable --config electron-builder.config.js --config.directories.output=release",
    "pack:lowmem": "electron-builder --win nsis --config.directories.output=release --config.compression=store",
    "build:all": "npm run clean && npm run build:main && npm run gen:buildinfo && npm run build:renderer",
    "gen:buildinfo": "node scripts/gen-build-info.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "assert:built": "node scripts/assert-built.mjs",
    "dist": "npm run assert:built && npm run pack:installer && npm run pack:portable",
    "release:patch": "npm run version:patch && npm run build:all && npm run dist",
    "release:patch:dev": "node scripts/release-flavour.mjs dev patch",
    "release:minor": "npm run version:minor && npm run build:all && npm run dist",
    "release:minor:dev": "node scripts/release-flavour.mjs dev minor",
    "release:major": "npm run version:major && npm run build:all && npm run dist",
    "release:major:dev": "node scripts/release-flavour.mjs dev major",
    "release:both": "node scripts/release-both.mjs",
    "pack:both": "node scripts/release-both.mjs none",
    "pack:dev": "node scripts/release-flavour.mjs dev none",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:held": "node test/heldOrders.test.mjs",
    "test:ipcguard": "node test/ipc-guard-optional.test.mjs",
    "test:tabs": "node test/node-tabs-claim.test.mjs",
    "test:held:electron": "node test/run-under-electron.mjs test/heldOrders.test.mjs",
    "test:log": "node test/logFile.test.mjs",
    "test:sync": "node test/syncEngine-failures.test.mjs",
    "test:refresh": "node test/catalogue-refresh-signal.test.mjs",
    "test:print-name": "node test/test-print-business-name.test.mjs",
    "test:theme-pull": "node test/theme-pull.test.mjs",
    "test:theme-vars": "node test/theme-vars.test.mjs",
    "test:refbundle": "node test/node-reference-bundle.test.mjs",
    "test:refunpack": "node test/node-reference-unpack.test.mjs",
    "test:peerrelay": "node test/peer-relay.test.mjs",
    "test:roster": "node test/roster-snapshot.test.mjs",
    "test:failover": "node test/failover-cursors.test.mjs",
    "test:managefetch": "node test/manage-fetch-refresh.test.mjs",
    "test:devicetoken": "node test/device-token-refresh.test.mjs",
    "test:idlelock": "node test/idle-lock.test.mjs",
    "test:failover:electron": "node test/run-under-electron.mjs test/failover-cursors.test.mjs",
    "test:desktop": "npx tsc -b tsconfig.main.json --force && npm run test:contrast && npm run test:branding && npm run test:log && npm run test:sync && npm run test:synctimeout && npm run test:syncdecouple && npm run test:expenseid && npm run test:order409 && npm run test:macfp && npm run test:refbundle && npm run test:refunpack && npm run test:peerrelay && npm run test:roster && npm run test:held:electron && npm run test:pin:electron && npm run test:token:electron && npm run test:failover:electron && npm run test:managefetch && npm run test:devicetoken && npm run test:idlelock && npm run test:tabs",
    "test:pin": "node test/pinCache.test.mjs",
    "test:a490": "node test/a490-permissions.test.mjs",
    "test:silent-update": "node test/silent-update-a508.test.mjs",
    "test:updater-task": "node test/updater-task-a509.test.mjs",
    "test:lazy-load": "node test/lazy-load-a517.test.mjs",
    "test:a519": "node test/a519-till-items.test.mjs",
    "test:a520": "node test/close-branch-a520.test.mjs",
    "test:a521": "node test/offline-tills-a521.test.mjs",
    "test:a523": "node test/self-closing-days-a523.test.mjs",
    "test:a529": "node test/foreign-page-a529.test.mjs",
    "test:a531": "node test/live-sync-a531.test.mjs",
    "test:a533": "node test/log-pull-a533.test.mjs",
    "test:a534": "node test/a534-small-items.test.mjs",
    "test:a535": "node test/branch-drawers-a535.test.mjs",
    "test:a537": "node test/menus-a537.test.mjs",
    "test:a544": "node test/branch-branding-a544.test.mjs",
    "test:a541": "node test/update-stuck-a541.test.mjs",
    "test:pin:electron": "node test/run-under-electron.mjs test/pinCache.test.mjs",
    "test:token": "node test/tokenStore.test.mjs",
    "test:token:electron": "node test/run-under-electron.mjs test/tokenStore.test.mjs",
    "test:synctimeout": "node test/sync-timeout.test.mjs",
    "test:syncdecouple": "node test/sync-decouple.test.mjs",
    "test:expenseid": "node test/expense-id-repair.test.mjs",
    "test:order409": "node test/order-409-not-synced.test.mjs",
    "test:macfp": "node test/machine-fingerprint.test.mjs",
    "test:contrast": "node test/contrast.test.mjs",
    "test:branding": "node test/branding-set.test.mjs"
  },
  "dependencies": {
    "@swiftpos/printing": "file:../../shared/printing",
    "@types/node": "^20.19.43",
    "@zaptill/core": "file:../../packages/core",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "electron": "43.8.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.4.5",
    "wait-on": "^8.0.3"
  },
  "description": "ZapTill offline-first point of sale terminal",
  "author": "ZapTill",
  "productName": "ZapTill",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
