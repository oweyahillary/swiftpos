{
  "name": "zaptill-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZapTill marketing website (static, Astro)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/**/*.test.mjs\"",
    "check": "node scripts/check-dist.mjs",
