# Cloudflare Pages headers (https://developers.cloudflare.com/pages/configuration/headers/).
# The marketing site's canonical home is www.zaptill.co.ke (app.zaptill.co.ke is the dashboard). Until www is attached
# to this Pages project, the site lives on its pages.dev address: keep search engines out of every pages.dev copy
# (production and previews). The real www domain is not matched, so the site is indexable the moment www is attached.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Night 3: long caching for files whose names never change in place. Astro's bundles carry a hash in the name; the
# fonts, videos and screenshots are re-made rarely, so a day, re-checked after that.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000

/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/screens/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/demo-products/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
