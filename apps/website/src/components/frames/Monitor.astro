---
// A counter monitor on a stand. The slot is a 16:10 screen; content inside sizes itself in container units.
interface Props { label: string }
const { label } = Astro.props;
---
<figure class="monitor" aria-label={label}>
  <div class="monitor__bezel">
    <div class="monitor__screen device-screen"><slot /></div>
  </div>
  <div class="monitor__neck" aria-hidden="true"></div>
  <div class="monitor__foot" aria-hidden="true"></div>
</figure>

<style>
  .monitor { margin: 0; width: 100%; }
  .monitor__bezel {
    background: #121c1f;
    border-radius: 14px;
    padding: 2.2%;
    box-shadow: inset 0 0 0 1px #2a3a3e, 0 30px 60px -30px rgba(0, 0, 0, 0.6);
  }
  .monitor__screen { aspect-ratio: 16 / 10; border-radius: 4px; }
  .monitor__neck {
    width: 14%; height: 34px; margin: 0 auto;
    background: linear-gradient(90deg, #172326, #24353a 50%, #172326);
  }
  .monitor__foot { width: 34%; height: 10px; margin: 0 auto; border-radius: 10px 10px 4px 4px; background: #1d2b2f; }
</style>
