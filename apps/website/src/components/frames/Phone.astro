---
// A phone, 9:19.5. Holds the owner's view: the daily summary or the dashboard on the go.
interface Props { label: string }
const { label } = Astro.props;
---
<figure class="phone" aria-label={label}>
  <div class="phone__body">
    <div class="phone__screen device-screen"><slot /></div>
  </div>
</figure>

<style>
  .phone { margin: 0; width: 100%; max-width: 300px; }
  .phone__body {
    background: #0d1517;
    border-radius: 13% / 6%;
    padding: 4.5%;
    box-shadow: inset 0 0 0 2px #2c3b3f, 0 30px 50px -28px rgba(0, 0, 0, 0.55);
  }
  .phone__screen { aspect-ratio: 9 / 19.5; border-radius: 9% / 4.2%; }
</style>
