---
// The ZapTill mark: the app icon's teal Z on its dark tile, plus the wordmark.
---
<a class="logo" href="/" aria-label="ZapTill home">
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect x="1" y="1" width="30" height="30" rx="8" fill="#050d12" stroke="#5eead4" stroke-width="1.4" />
    <path d="M10 9.5h12.5v3.2l-8.2 9.3h8.4v3.5H9.6v-3.2l8.2-9.3H10z" fill="#14b8a6" />
  </svg>
  <span class="logo__word">ZapTill</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none; color: inherit; }
  .logo__mark { width: 34px; height: 34px; }
  .logo__word { font: 800 1.35rem/1 var(--font-display); letter-spacing: -0.03em; }
</style>
