---
// One "Do this next" card, styled like the Analytics page in the app. The words and figures are the seeded demo
// restaurant's (the A558 cards, apps/server/src/lib/analyticsRules.ts), never a client's. The label says so.
// Defaults: card 2, the Tusker price card (WORKPLAN §5.4).
interface Props {
  showPayback?: boolean;
  /** Hide the "Example from a demo restaurant" label (when a group of cards carries one label). */
  bare?: boolean;
  n?: number;
  title?: string;
  body?: string;
  estimate?: string;
  unit?: string;
  assumes?: string;
  /** 3 = Strong evidence, 2 = Good evidence, 1 = Worth a try */
  evidence?: 1 | 2 | 3;
  tab?: string;
}
const {
  showPayback = false,
  bare = false,
  n = 2,
  title = 'Raise the price of Tusker lager by KES 40',
  body = 'It is a best seller (880 sold, number 1) but leaves KES 110 each after its cost: KES 141 below your average of KES 251.',
  estimate = 'KES 35,200',
  unit = 'a month more profit',
  assumes = 'If the same 880 a month still sell at KES 340.',
  evidence = 3,
  tab = 'Menu engineering',
} = Astro.props;
const evidenceLabel = { 3: 'Strong evidence', 2: 'Good evidence', 1: 'Worth a try' }[evidence];
---
<figure class:list={['dtn', { 'dtn--bare': bare }]}>
  {!bare && <figcaption class="dtn__label">Example from a demo restaurant</figcaption>}
  <div class="dtn__card">
    <div class="dtn__head">
      <span class="dtn__num" aria-hidden="true">{n}</span>
      <h3 class="dtn__title">{title}</h3>
    </div>
    <p class="dtn__body">{body}</p>
    <p class="dtn__estimate">
      <span>Estimate:</span> <strong>&asymp; {estimate}</strong> <span>{unit}</span>
    </p>
    <p class="dtn__if">{assumes}</p>
    <div class="dtn__foot">
      <span class="dtn__evidence" data-level={evidence}><i></i><i></i><i></i> {evidenceLabel}</span>
      <span class="dtn__why">See why &middot; {tab}</span>
    </div>
  </div>
  {showPayback && (
    <p class="dtn__payback">
      Analytics is planned at about KES 10,000 a month. If this one estimate holds, it covers that three times over.
      Every card says what it assumes, so you can judge it yourself.
    </p>
  )}
</figure>

<style>
  .dtn { margin: 0; max-width: 30rem; }
  .dtn--bare { max-width: none; height: 100%; }
  .dtn--bare .dtn__card { height: 100%; display: flex; flex-direction: column; }
  .dtn--bare .dtn__foot { margin-top: auto; }
  .dtn__label {
    display: inline-block;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-2);
    background: var(--teal-wash);
    border: 1px solid #b7e4de;
    padding: 0.2rem 0.65rem;
    border-radius: var(--r-pill);
    margin-bottom: var(--s-3);
  }
  .dtn__card {
    background: #111a1c;
    color: #e3ecec;
    border: 1px solid #24353a;
    border-radius: var(--r-md);
    padding: 1.15rem 1.2rem 1rem;
    box-shadow: var(--shadow-object);
  }
  .dtn__head { display: flex; gap: 0.7rem; align-items: flex-start; margin-bottom: 0.6rem; }
  .dtn__num {
    flex: none; display: grid; place-items: center;
    width: 1.7rem; height: 1.7rem; border-radius: 50%;
    background: #e3ecec; color: #111a1c; font-weight: 700; font-size: 0.9rem;
  }
  .dtn__title { font: 700 1.1rem/1.3 var(--font-text); letter-spacing: 0; margin: 0.1rem 0 0; color: #fff; }
  .dtn__body { font-size: 0.95rem; color: #cbd8d8; margin-bottom: 0.9rem; }
  .dtn__estimate { margin: 0; color: #9fb2b2; }
  .dtn__estimate strong { font: 800 1.35rem/1.2 var(--font-text); color: #fff; }
  .dtn__if { font-size: 0.82rem; color: #8da2a2; margin: 0.15rem 0 0.9rem; }
  .dtn__foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem;
    border-top: 1px solid #24353a; padding-top: 0.7rem; font-size: 0.85rem;
  }
  .dtn__evidence { display: inline-flex; align-items: center; gap: 3px; color: #cbd8d8; }
  .dtn__evidence i { width: 4px; height: 12px; background: #e3ecec; border-radius: 1px; }
  .dtn__evidence[data-level='2'] i:nth-of-type(3),
  .dtn__evidence[data-level='1'] i:nth-of-type(n + 2) { background: #3a4b4f; }
  .dtn__evidence i:last-of-type { margin-right: 0.4rem; }
  .dtn__why { color: #5eead4; }
  .dtn__payback { margin-top: var(--s-4); color: var(--ink-2); font-size: var(--fs-sm); max-width: 28rem; }
</style>
