---
// The day close on the web dashboard: each cashier's drawer, M-Pesa total and over or short. Demo data.
const rows = [
  { name: 'Wanjiru', mpesa: '26,300', expected: '14,550', counted: '14,200', diff: '-350', state: 'short' },
  { name: 'Otieno', mpesa: '19,850', expected: '13,250', counted: '13,250', diff: '0', state: 'exact' },
  { name: 'Brian', mpesa: '5,950', expected: '4,000', counted: '4,050', diff: '+50', state: 'over' },
];
---
<div class="dc" role="img" aria-label="The day close on the web dashboard for a demo branch: three cashiers, their M-Pesa totals, cash expected and counted, and who was over or short.">
  <div class="dc__side">
    <span class="dc__logo">Z</span>
    <span class="on">Day close</span><span>Overview</span><span>Sales</span><span>Stock</span><span>Staff</span><span>Analytics</span>
  </div>
  <div class="dc__main">
    <div class="dc__head">
      <div>
        <p class="dc__title">Day close</p>
        <p class="dc__sub">Mama Lishe Grill &middot; Ngong Road &middot; Tue 21 Oct</p>
      </div>
      <span class="dc__btn">Close branch</span>
    </div>
    <div class="dc__tiles">
      <div><span>Sales</span><b>84,350</b></div>
      <div><span>M-Pesa</span><b>52,100</b></div>
      <div><span>Cash</span><b>27,450</b></div>
      <div class="warn"><span>Over / short</span><b>-300</b></div>
    </div>
    <table class="dc__table">
      <thead><tr><th>Cashier</th><th>M-Pesa</th><th>Cash expected</th><th>Counted</th><th>Over / short</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td>{r.name}</td><td>{r.mpesa}</td><td>{r.expected}</td><td>{r.counted}</td>
            <td><span class:list={['pill', r.state]}>{r.diff}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  .dc {
    position: absolute; inset: 0;
    display: grid; grid-template-columns: 17% 1fr;
    font-family: var(--font-text); font-size: 1.6cqw; line-height: 1.3;
    background: #f4f7f7; color: #142226;
  }
  .dc__side { background: #0b1719; color: #9fb7b5; display: flex; flex-direction: column; gap: 0.25em; padding: 1em 0.7em; }
  .dc__side span { padding: 0.5em 0.6em; border-radius: 0.4em; }
  .dc__side .on { background: #12302d; color: #5eead4; font-weight: 700; }
  .dc__logo { color: #14b8a6; font: 800 1.6em/1 var(--font-display); padding: 0 0.4em 0.5em !important; }
  .dc__main { padding: 1.2em 1.4em; overflow: hidden; }
  .dc__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1em; margin-bottom: 1em; }
  .dc__title { font: 700 1.5em/1.1 var(--font-display); margin: 0; }
  .dc__sub { color: #56686d; margin: 0.2em 0 0; }
  .dc__btn { background: #0f766e; color: #fff; font-weight: 700; padding: 0.55em 0.9em; border-radius: 0.45em; white-space: nowrap; }
  .dc__tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.7em; margin-bottom: 1em; }
  .dc__tiles div { background: #fff; border: 1px solid #d9e3e3; border-radius: 0.5em; padding: 0.6em 0.75em; }
  .dc__tiles span { display: block; color: #56686d; font-size: 0.85em; }
  .dc__tiles b { font: 700 1.3em/1.2 var(--font-display); }
  .dc__tiles .warn b { color: #b42318; }
  .dc__table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #d9e3e3; border-radius: 0.5em; }
  .dc__table th { text-align: left; font-size: 0.85em; color: #56686d; font-weight: 600; padding: 0.6em 0.75em; border-bottom: 1px solid #d9e3e3; }
  .dc__table td { padding: 0.65em 0.75em; border-bottom: 1px solid #eef3f3; font-variant-numeric: tabular-nums; }
  .pill { display: inline-block; padding: 0.15em 0.6em; border-radius: 99px; font-weight: 700; }
  .pill.short { background: #fde8e6; color: #b42318; }
  .pill.exact { background: #e6f6f4; color: #0f766e; }
  .pill.over { background: #fff4d6; color: #6b4400; }
</style>
