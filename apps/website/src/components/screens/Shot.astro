---
// A real screen captured from the app running a made-up demo business, as a WebP in public/screens/
// (scripts/make-screens.mjs). Sits inside a device frame, or on its own with `framed={false}`.
// Below the fold by default (lazy); pass eager for one in the first screenful.
interface Props { src: string; alt: string; width: number; height: number; eager?: boolean; class?: string; position?: string }
const { src, alt, width, height, eager = false, class: extra, position = 'top left' } = Astro.props;
---
<img
  class:list={['shot', extra]}
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  fetchpriority={eager ? 'high' : undefined}
  style={`object-position:${position}`}
/>

<style>
  .shot { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
