---
import Base from '../layouts/Base.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---
<Base title="Page not found | ZapTill" description="This page does not exist. Go back to the ZapTill home page, or message us on WhatsApp.">
  <section class="page-head">
    <div class="wrap">
      <h1>That page isn't here.</h1>
      <p class="lede">The link may be old. Start again from the <a href="/">home page</a>, or ask us directly.</p>
      <WhatsAppButton />
    </div>
  </section>
</Base>
