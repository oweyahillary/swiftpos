---
import Base from '../layouts/Base.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { WA_MESSAGES } from '../lib/site';

// Public scope (owner, 2026-11-13): market only the tested restaurant/hotel POS — restaurants, cafés, bars and quick
// service. The other verticals (shops, minimarts, petrol, parking) are parked: their /for pages stay in the repo but are
// unlinked and noindexed. Each lane keeps to what ships (WORKPLAN §3); words per type follow shared/businessTerms.ts.
const lanes = [
  {
    href: '/for/restaurants/',
    name: 'Restaurants and cafés',
    line: 'From the order to the plate, nothing gets lost.',
    points: ['Kitchen and dispatch tickets, and a kitchen display', 'Variants and combos on one line', 'Tables, takeaway and delivery'],
  },
  {
    href: '/for/bars/',
    name: 'Bars and lounges',
    line: 'Know whose drawer is short before the lights go off.',
    points: ['Over and short by name at every close', 'Voids need a manager\'s PIN', 'Credit for regulars, with limits'],
  },
  {
    href: '/for/quick-service/',
    name: 'Quick service and takeaways',
    line: 'Faster at the counter. Right in the bag.',
    points: ['A fast counter point of sale', 'Dispatch tickets that count the bags', 'Offers, delivery fees and M-Pesa'],
  },
];
---
<Base
  title="Who ZapTill is for: restaurants, cafés, bars, takeaways"
  description="ZapTill is set up for restaurants, cafés, bars, lounges and quick-service takeaways in Kenya: menus, tables, the kitchen, M-Pesa and the day close."
  waMessage={WA_MESSAGES.demo}
  ogImage="/og/who-its-for.png"
>
  <section class="page-head hub-head">
    <div class="wrap">
      <h1>Made for the way your place works</h1>
      <p class="lede">
        A restaurant needs its kitchen to keep up. A bar needs every drawer to add up after midnight. A takeaway needs a
        fast counter and the right bag. It is the same ZapTill, set up for each in its own words, and we set it up with
        you.
      </p>
    </div>
  </section>

  <section class="band" aria-label="Kinds of business">
    <div class="wrap">
      <ul class="hub">
        {lanes.map((l) => (
          <li>
            <a href={l.href} class="hub__card">
              <h2 class="hub__name">{l.name}</h2>
              <p class="hub__line">{l.line}</p>
              <ul class="ticks hub__points">{l.points.map((p) => <li>{p}</li>)}</ul>
              <span class="hub__go">Read more about ZapTill for {l.name.toLowerCase()}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band--white final" aria-labelledby="wif-final">
    <div class="wrap">
      <h2 id="wif-final">See it running in a place like yours.</h2>
      <div class="actions">
        <WhatsAppButton message={WA_MESSAGES.demo} />
      </div>
    </div>
  </section>
</Base>

<style>
  .hub-head { background: var(--card); border-bottom: 1px solid var(--line); }
  .hub { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-4); }
  .hub__card {
    display: flex; flex-direction: column; height: 100%;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--r-lg);
    padding: var(--s-5) var(--s-5) var(--s-4);
    text-decoration: none; color: var(--ink);
    border-top: 4px solid var(--teal);
  }
  .hub__card:hover { border-color: var(--teal-strong); }
  .hub__card:hover .hub__go { text-decoration: underline; }
  .hub__name { font-size: var(--fs-lg); margin-bottom: var(--s-2); }
  .hub__line { color: var(--ink-2); font-size: var(--fs-md); line-height: 1.4; }
  .hub__points { margin-bottom: var(--s-5); color: var(--ink-2); }
  .hub__go { margin-top: auto; color: var(--teal-strong); font-weight: 600; }
  @media (min-width: 760px) { .hub { grid-template-columns: repeat(3, 1fr); gap: var(--s-5); } }

  .final h2 { max-width: 24ch; }
</style>
