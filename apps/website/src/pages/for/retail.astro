---
import Industry from '../../layouts/Industry.astro';
import Laptop from '../../components/frames/Laptop.astro';
import StockScreen from '../../components/screens/StockScreen.astro';
import Shot from '../../components/screens/Shot.astro';
import Receipt from '../../components/screens/Receipt.astro';
import LabelSamples from '../../components/screens/LabelSamples.astro';
import Monitor from '../../components/frames/Monitor.astro';
import ProductVideo from '../../components/ProductVideo.astro';
import { WA_MESSAGES } from '../../lib/site';
import { RETAIL_FAQ } from '../../lib/faq';

// Shop words (owner, 2026-10-22, A573): departments, products, barcodes, labels, stock. No menus, kitchens or tables.
// 2026-10-23: shops and supermarkets (minimarts have their own page, /for/minimarts/); items sold by weight (A577) and
// departments by the hour (A578) now ship, so they are described.
const problems = [
  {
    problem: 'Half the shelf has no barcode, so the cashier types or guesses.',
    fix: 'ZapTill gives every product without a barcode its own in-store code and prints the labels, so every item scans. The manufacturer\'s barcodes keep working as they are.',
  },
  {
    problem: 'Stock goes missing, and nobody can say where.',
    fix: 'Count your stock in ZapTill and see the difference against what the system expected. Damaged or expired goods are written off with a reason and their cost, not just thrown away.',
  },
  {
    problem: 'The delivery was short, and you paid for the full order.',
    fix: 'Receive each delivery against the supplier\'s note. Stock goes up by what actually arrived, and the supplier\'s bill sits next to it.',
  },
  {
    problem: 'A customer asks for something you\'ve run out of, and walks out.',
    fix: 'Look it up at your other branches from the point of sale, and a manager asks that branch to send some. When it is gone, you choose whether the point of sale keeps selling it, shows it as sold out, or hides it until stock comes in.',
  },
  {
    problem: 'The deli and the butchery weigh on a scale, and the price is typed in by hand.',
    fix: 'Mark those items as sold by weight: the cashier types the weight on the point of sale, or scans the label your scale prints with the weight or price inside. Stock comes off to the gram.',
  },
  {
    problem: 'The cash at closing never matches the sales.',
    fix: 'Each cashier counts their own drawer. ZapTill shows what should be there, what was counted and the difference, by name.',
  },
];
---
<Industry
  title="Supermarket and shop POS in Kenya: barcodes, stock | ZapTill"
  description="ZapTill for shops and supermarkets in Kenya: barcodes and labels, items sold by weight, stock and suppliers, drawers counted by cashier, M-Pesa on every receipt."
  ogImage="/og/retail.png"
  kicker="Shop and supermarket POS in Kenya"
  guides={['stop-cash-going-missing', 'run-two-branches-without-being-there']}
  crumb="Shops and supermarkets"
  heading="Stock that adds up. A point of sale that never stops."
  sub="ZapTill puts a barcode on every product, weighs what you sell loose, keeps your stock honest from the supplier's delivery to the shelf, moves it between branches, and closes every drawer by name, with or without internet."
  waMessage={WA_MESSAGES.retail}
  problems={problems}
  faq={RETAIL_FAQ}
  closing="See your own stock on ZapTill."
>
  <Fragment slot="hero">
    <Laptop label="Receiving a delivery and writing off wastage on the web dashboard">
      <StockScreen />
    </Laptop>
  </Fragment>

  <section class="band" aria-labelledby="rlabels-h">
    <div class="wrap">
      <div class="split split--top">
        <div class="split__copy">
          <h2 id="rlabels-h">A barcode on every product, a label on any printer</h2>
          <p>
            Products that came without a barcode get one from ZapTill: an in-store code, in your own numbering, that no
            manufacturer uses. Codes you already have are never changed, and the scanner reads both.
          </p>
          <p>
            Then print the labels on whatever you have: a label printer in any size, A4 sticker sheets on an office
            printer (start at any sticker on a part-used sheet), or the receipt printer. Every label carries the barcode,
            with the name and the price if you want them. When a delivery comes in, print labels for just the items in
            it.
          </p>
          <p class="r-note">Printing labels from the point of sale comes with ZapTill Online. When a price changes, print the
            label again.</p>
        </div>
        <div class="split__visual">
          <LabelSamples />
          <p class="r-note">Drawn by ZapTill's own label code, for Kijani Basket (a fictional demo minimart).</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--white" aria-labelledby="rdept-h">
    <div class="wrap">
      <div class="split r-till">
        <div class="split__copy">
          <h2 id="rdept-h">Built around how a shop sells</h2>
          <p>Departments across the top, every product scannable, and the weighed items on a keypad: this is the real
            ZapTill point of sale at a demo shop.</p>
        </div>
        <div class="split__visual">
          <Monitor label="The ZapTill point of sale at a demo shop">
            <Shot src="/screens/till-shop.webp" width={1280} height={800}
              alt="The real ZapTill point of sale at a demo shop: departments as big tabs (All, Groceries, Beverages, Personal care), and a bill of milk, bread, maize flour, eggs and 0.640 kg of beef at KES 650 a kilo, total KES 1,246." />
          </Monitor>
        </div>
      </div>
      <div class="grid4">
        <div>
          <h3>Departments across the top</h3>
          <p>Groceries, Beverages, Toiletries: your departments as big tabs on the point of sale, so the cashier finds an item
            without scrolling. Or just scan it.</p>
        </div>
        <div>
          <h3>When stock runs out</h3>
          <p>You choose, once: keep selling as normal, show it as sold out so it can't be rung up, or hide it until the
            next delivery is in.</p>
        </div>
        <div>
          <h3>Your other branches' shelves</h3>
          <p>Staff who can see stock check what another branch holds, and a manager asks that branch to send some. The
            transfer keeps both stock levels right.</p>
        </div>
        <div>
          <h3>Customers on account</h3>
          <p>A trusted customer gets an account with a credit limit. The cashier puts the bill on it at the point of sale, and
            the dashboard shows who owes you and for how long.</p>
        </div>
        <div>
          <h3>Sold by weight</h3>
          <p>Type the weight on the POS keypad, or scan the label your scale prints. The receipt says "0.640 kg @
            650/kg" and the stock comes off to the gram.</p>
        </div>
        <div>
          <h3>Departments by the hour</h3>
          <p>Give the alcohol department your licensed hours. Outside them its items leave the point of sale, and a scan is
            refused with the reason on screen.</p>
        </div>
        <div>
          <h3>Suppliers and what you owe</h3>
          <p>Deliveries are received against the supplier's note, the supplier's bill sits next to it, and you see what
            you still owe each one.</p>
        </div>
        <div>
          <h3>What sells together</h3>
          <p>With ZapTill Analytics: "Put White bread next to Fresh milk", what to order before Friday, and never a
            price rise. <a href="/analytics/">See Analytics</a></p>
        </div>
      </div>
      <p class="r-note">Stock at the point of sale, checking other branches and labels from the point of sale come with ZapTill Online.{' '}
        <a href="/pricing/">See the packages</a></p>
    </div>
  </section>

  <section class="band band--night" aria-labelledby="rvid-h">
    <div class="wrap split split--flip">
      <div class="split__copy">
        <h2 id="rvid-h">A sale at the counter, from scan to receipt</h2>
        <p>Milk, bread, flour and eggs on the bill, the beef weighed at 0.640 kg, paid by M-Pesa, and the receipt prints
          with the shop's own logo. The real ZapTill point of sale, branded for Kijani Basket, a made-up minimart.</p>
      </div>
      <div class="split__visual">
        <ProductVideo name="shop" note="Kijani Basket: scan, weigh, M-Pesa, receipt." label="Kijani Basket, a minimart: two fresh milk, white bread, maize flour and a tray of eggs go on the bill, beef is weighed at 0.640 kg on the keypad, the customer pays KES 1,246 by M-Pesa and the receipt prints with the shop's logo." />
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="rclose-h">
    <div class="wrap split">
      <div class="split__copy">
        <h2 id="rclose-h">Every drawer, counted by name</h2>
        <p>
          Each cashier opens with a counted float and closes with a counted drawer. The manager sees each one's expected
          cash, counted cash and difference, confirms it, and closes the day from the point of sale or the web.
        </p>
      </div>
      <div class="split__visual">
        <figure class="screen-crop">
          <Shot src="/screens/till-shifts.webp" width={1200} height={253}
            alt="The real ZapTill shift report: two drawers with expected cash, counted cash and the difference; one KES 350 short, one exact." />
        </figure>
      </div>
    </div>
  </section>

  <section class="band band--white" aria-labelledby="rrec-h">
    <div class="wrap split split--flip">
      <div class="split__copy">
        <h2 id="rrec-h">M-Pesa on every receipt</h2>
        <p>
          The receipt carries your Buy Goods or Paybill number in large print, and a split payment shows each part. This
          is the real receipt ZapTill prints, with the shop's own logo at the top, for Kijani Basket, a made-up minimart.
        </p>
      </div>
      <div class="split__visual r-rec">
        <Receipt kind="shop" />
      </div>
    </div>
  </section>
</Industry>

<style>
  .r-rec { display: flex; justify-content: center; }
  .r-rec :global(.slip-wrap) { --slip-fs: 0.72rem; }
  .r-note { font-size: var(--fs-sm); color: var(--muted); }
  .grid4 + .r-note { margin-top: var(--s-5); }
  .grid4 { display: grid; gap: var(--s-5); margin-top: var(--s-7); }
  .r-till .split__copy p { color: var(--ink-2); }
  .grid4 h3 { font-size: var(--fs-md); margin-bottom: var(--s-2); }
  .grid4 p { color: var(--ink-2); margin: 0; }
  @media (min-width: 700px) { .grid4 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .grid4 { grid-template-columns: repeat(4, 1fr); } }
</style>
