<script is:inline>
  // The business-type filter: shows one type's features (and the groups that have any), remembers it in ?type=.
  // Without JavaScript the filter stays hidden and every feature shows.
  (function () {
    var box = document.querySelector('[data-filter]');
    if (!box) return;
    var btns = Array.prototype.slice.call(box.querySelectorAll('[data-type]'));
    var items = Array.prototype.slice.call(document.querySelectorAll('.feat li[data-types], .feat-jump li[data-types]'));
    var groups = Array.prototype.slice.call(document.querySelectorAll('[data-group]'));
    var none = document.querySelector('[data-none]');
    var valid = btns.map(function (b) { return b.getAttribute('data-type'); });
    function show(type, push) {
      if (valid.indexOf(type) < 0) type = 'all';
      btns.forEach(function (b) { b.setAttribute('aria-pressed', String(b.getAttribute('data-type') === type)); });
      items.forEach(function (li) { li.hidden = type !== 'all' && li.getAttribute('data-types').split(' ').indexOf(type) < 0; });
      var shown = 0;
      groups.forEach(function (g) {
        var lis = g.querySelectorAll('li[data-types]');
        var any = Array.prototype.some.call(lis, function (li) { return !li.hidden; });
        g.hidden = !any; if (any) shown++;
      });
      if (none) none.hidden = shown > 0;
      // Night 3: say what changed, for screen readers (the list below changes with no focus move).
      var status = box.querySelector('[data-filter-status]');
      if (status && push) {
        var n = items.filter(function (li) { return !li.hidden && li.closest('.feat'); }).length;
        var b = btns.filter(function (x) { return x.getAttribute('data-type') === type; })[0];
        status.textContent = 'Showing ' + n + ' features for ' + (b ? b.textContent : 'every business') + '.';
      }
      if (push && window.history && history.replaceState) {
        var u = new URL(window.location.href);
        if (type === 'all') u.searchParams.delete('type'); else u.searchParams.set('type', type);
        history.replaceState(null, '', u.toString());
      }
    }
    btns.forEach(function (b) { b.addEventListener('click', function () { show(b.getAttribute('data-type'), true); }); });
    box.hidden = false;
    var start = 'all';
    try { start = new URL(window.location.href).searchParams.get('type') || 'all'; } catch (e) {}
    show(start, false);
  })();
</script>

