---
import Base from '../layouts/Base.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import VisitButton from '../components/VisitButton.astro';
import Monitor from '../components/frames/Monitor.astro';
import Laptop from '../components/frames/Laptop.astro';
import Shot from '../components/screens/Shot.astro';
import Receipt from '../components/screens/Receipt.astro';
import StockScreen from '../components/screens/StockScreen.astro';
import DayCloseScreen from '../components/screens/DayCloseScreen.astro';
import DoThisNextCard from '../components/screens/DoThisNextCard.astro';
import LabelSamples from '../components/screens/LabelSamples.astro';
import { WA_MESSAGES, TRADES, type Trade } from '../lib/site';
import { ROLES } from '../lib/roles';
import { softwareApplication } from '../lib/schema';
import { SHOP_CARDS } from '../lib/analyticsDemo';

// 2026-10-23 (owner: the site "markets more of restaurant than all the other businesses"): every feature is tagged with
// the business types it fits, and a filter at the top shows one type's features (?type=food|shop|petrol|parking). Without
// JavaScript every feature shows. Shop features (barcodes, labels, weighed items, departments, stock, suppliers, credit,
// other branches) come before the kitchen. Only what ships (WORKPLAN §3); petrol and parking checked against the code.
const description =
  'Every ZapTill POS feature, filtered by business: M-Pesa, barcodes and labels, stock, kitchen tickets, pumps and fuel, parking, the day close and branches.';

const F: Trade = 'food', S: Trade = 'shop', P: Trade = 'petrol', K: Trade = 'parking';
const ALL: Trade[] = [F, S, P, K];
const NAMES: Record<Trade, string> = { food: 'Restaurants', shop: 'Shops', petrol: 'Petrol', parking: 'Car parks' };
type Item = { t: string; types: Trade[] };
const i = (t: string, types: Trade[] = ALL): Item => ({ t, types });

const sell: Item[] = [
  i('Your items as big buttons, with big tabs across the top: departments in a shop (Groceries, Beverages, Household), menus in a restaurant (Food, Drinks, Tea)', [F, S, P]),
  i('Scan a barcode and the item is on the bill', [S, P]),
  i('Items sold by weight: type the weight on a keypad, or scan the label your scale prints; the receipt says "0.640 kg @ 650/kg"', [S, P, F]),
  i('Departments or menus by the hour: alcohol only in your licensed hours, breakfast only in the morning; a scan outside the hours is refused'),
  i('Split a bill between cash, M-Pesa and card'),
  i('Sales on account for regulars, within the credit limit you set, confirmed by a manager', [F, S, P]),
  i('When an item runs out, you choose: keep selling, show it as sold out, or hide it until stock comes in', [F, S, P]),
  i('Discounts and tips, for the staff you allow'),
  i('Dine-in with tables, takeaway and delivery from the same screen', [F]),
  i('Hold an order and pick it up again when the table wants more', [F]),
  i('Notes for the kitchen, like "No onions"', [F]),
  i('Reprint a receipt when a customer asks'),
];
const labels: Item[] = [
  i('Products without a barcode get one: an in-store code in your own numbering, never a code you already have', [S, P]),
  i('The manufacturer\'s barcodes keep working as they are', [S, P]),
  i('Print labels on a label printer (TSC, Xprinter, Zebra and others), any size', [S, P]),
  i('Or on A4 sticker sheets from an office printer, starting at any sticker on a part-used sheet', [S, P]),
  i('Or on the receipt printer', [S, P]),
  i('Every label carries the barcode; the name, the price and your shop\'s name if you want them', [S, P]),
  i('Print labels for one item, a department, or the items in a delivery', [S, P]),
];
const stock: Item[] = [
  i('Stock levels for every product (and every ingredient in a kitchen)', [S, P, F]),
  i('Deliveries received against the supplier\'s note', [S, P, F]),
  i('Supplier bills and what you still owe each supplier', [S, P, F]),
  i('Stock counts, and the difference against what the system expected', [S, P, F]),
  i('Wastage and expired goods written off with a reason and their cost', [S, P, F]),
  i('Transfers between branches, sent by one and received by the other', [S, P, F]),
  i('See what your other branches hold, and ask one of them to send some', [S, P, F]),
  i('Low stock in the daily email', [S, P, F]),
  i('Recipes, so you know what each dish costs to make', [F]),
];
const kitchen: Item[] = [
  i('Kitchen tickets and dispatch (packing) tickets, printed as the order is sent', [F]),
  i('Each part of the menu to its own station: grill, kitchen, bar or dispatch', [F]),
  i('Variants on the dish\'s own line: "Chips Masala - Spicy"', [F]),
  i('Extras and the cashier\'s notes under the dish: "+ Extra Cheese", "** No onions"', [F]),
  i('Combos list their parts, so every piece is cooked and packed', [F]),
  i('A kitchen display: each order as a card with a timer, Pending to Ready', [F]),
  i('Items taken back after they reached the kitchen are recorded, with who approved it', [F]),
];
const fuel: Item[] = [
  i('The point of sale opens on your pumps, each with its grade and price a litre', [P]),
  i('Sell by amount or by litres, or tap 500, 1,000, 2,000 or 5,000; the other is worked out', [P]),
  i('Every fuel sale records its pump; fuel and shop items go on one sale', [P]),
  i('Fuel grades priced a litre, and each branch can have its own price', [P]),
  i('Tanks in litres: deliveries recorded, each sale taken off its tank, low tanks flagged', [P]),
  i('Fuel sales by grade, by pump and by hour; the Pump Monitor; tank reconciliation; a delivery log', [P]),
  i('The ready-made Fuel attendant role', [P]),
  i('The pumps and their prices are on the desktop POS, so the forecourt sells with no internet', [P]),
];
const parking: Item[] = [
  i('Parking bays on the web POS: open a bay with the number plate, the vehicle type and the rate an hour', [K]),
  i('Each hour started is charged, at least one; paid by cash, M-Pesa or card', [K]),
  i('A bay can\'t be opened twice; a vehicle that left without paying is recorded', [K]),
  i('Bays laid out in zones; the Parking Overview shows free and occupied bays, the occupancy and every open session', [K]),
  i('Car wash, permits and other items sold in your own groups', [K]),
];
const money: Item[] = [
  i('An opening float counted by each cashier', [F, S, P]),
  i('Drawer counts, with over and short for each cashier', [F, S, P]),
  i('Each cashier\'s takings by payment method: cash, M-Pesa, card', [F, S, P]),
  i('A manager confirms every shift', [F, S, P]),
  i('The cashier\'s own slip shows what they declared, never what was expected', [F, S, P]),
  i('Cash paid out and expenses from the drawer, each with who approved it', [F, S, P]),
  i('Close the day and the branch, from the point of sale or from the web', [F, S, P]),
  i('Your Buy Goods or Paybill number, large on every receipt'),
];
const staff: Item[] = [
  i('Ready-made roles, so setting up staff takes minutes'),
  i('A PIN for each person at the point of sale; every sale and void carries their name'),
  i('A paid order can only be voided or refunded with a manager\'s PIN'),
  i('Your partner and your accountant sign in to the web dashboard with their own logins, never yours'),
  i('Sales and voids by cashier in the reports'),
  i('The owner sets their own password at the first sign-in'),
];
const branches: Item[] = [
  i('Every branch on one web dashboard, side by side or one at a time'),
  i('Stock in every branch: who has it, and a request to send some', [F, S, P]),
  i('A daily summary email, at the time you choose'),
  i('Close a branch\'s day from the web', [F, S, P]),
  i('Your logo on the receipt; each branch can have its own colours on the point of sale and its own receipt footer'),
  i('Add a branch later; it joins the same dashboard, with no second cloud fee'),
];
const analytics: Item[] = [
  i('"Do this next": a short, ranked list in plain words: what to order before Friday, what to have in for a busy day, old credit to chase', [F, S, P]),
  i('What sells together, in your trade\'s words: "Put White bread next to Fresh milk", "Offer Water at the pumps", a combo in a restaurant', [F, S, P]),
  i('Your week at a glance: what sells each day and at every hour', [F, S, P]),
  i('Stock between branches: "it sells fast at one branch and slowly at another: consider moving some"', [F, S, P]),
  i('The Watch list: voids, refunds, big discounts, short drawers and sales below the list price, as warnings to look into; at a car park, vehicles let out with no charge'),
  i('Products that still have no cost, so every margin is complete', [F, S, P]),
  i('Menu engineering: which dishes earn their place', [F]),
  i('Credit ageing: who owes you, and for how long', [F, S, P]),
  i('It never suggests raising your prices'),
];
const support: Item[] = [
  i('Setup on site: your products or menu loaded, printers and screens set up, your staff trained'),
  i('Updates install themselves, quietly, when the POS computer starts'),
  i('Support can pull a point of sale\'s log remotely to see what went wrong'),
  i('Support from 8 am to 7 pm, and 24 hours a day for priority clients'),
  i('A "what to do when" help screen on the point of sale, which works with no internet', [F, S, P]),
  i('Reports download to Excel whenever you want them'),
];
const offline: Item[] = [
  i('Points of sale keep selling and printing with no internet: the scanner, the kitchen tickets and the pumps', [F, S, P]),
  i('Staff still sign in with their PIN', [F, S, P]),
  i('A branch server keeps every point of sale in the branch in step', [F, S, P]),
  i('Everything catches up by itself when the line is back; nobody types anything in again', [F, S, P]),
  i('The POS computer needs power like any computer; a small UPS keeps it going through a short cut', [F, S, P]),
];

const groups = [
  { id: 'sell', name: 'Sell', types: ALL },
  { id: 'labels', name: 'Barcodes and labels', types: [S, P] },
  { id: 'stock', name: 'Stock and suppliers', types: [S, P, F] },
  { id: 'kitchen', name: 'Kitchen', types: [F] },
  { id: 'fuel', name: 'Pumps and fuel', types: [P] },
  { id: 'parking', name: 'Parking', types: [K] },
  { id: 'money', name: 'Money and day close', types: ALL },
  { id: 'staff', name: 'Staff and roles', types: ALL },
  { id: 'branches', name: 'Branches and branding', types: ALL },
  { id: 'analytics', name: 'Analytics', types: ALL },
  { id: 'support', name: 'Support and updates', types: ALL },
  { id: 'offline', name: 'Works offline', types: [F, S, P] },
];
const tags = (types: Trade[]) => (types.length === ALL.length ? [] : types.map((t) => NAMES[t]));
const shopCard = SHOP_CARDS[1];
---
<Base
  title="POS features: M-Pesa, stock, barcodes, kitchen, pumps | ZapTill"
  description={description}
  waMessage={WA_MESSAGES.features}
  ogImage="/og/features.png"
  jsonLd={[softwareApplication(description)]}
>
  <section class="page-head feat-head">
    <div class="wrap">
      <h1>Everything it does, for every kind of business</h1>
      <p class="lede">
        ZapTill is a point of sale (POS) for the counter, the pumps or the kitchen, and a back office on the web that opens on your
        phone. Each feature below says which businesses it is for; the screens are the real app, on made-up businesses.
      </p>
      <div class="feat-filter" data-filter hidden>
        <p class="feat-filter__label" id="filter-label">Show the features for:</p>
        <div class="feat-filter__btns" role="group" aria-labelledby="filter-label">
          <button type="button" data-type="all" aria-pressed="true">Every business</button>
          {TRADES.map((t) => <button type="button" data-type={t.id} aria-pressed="false">{t.name}</button>)}
        </div>
        <p class="visually-hidden" aria-live="polite" data-filter-status></p>
      </div>
      <nav class="feat-jump" aria-label="Feature groups">
        <ul>{groups.map((g) => <li data-types={g.types.join(' ')}><a href={`#${g.id}`}>{g.name}</a></li>)}</ul>
      </nav>
    </div>
  </section>

  <!-- Sell -->
  <section class="band feat" id="sell" data-group aria-labelledby="sell-h">
    <div class="wrap split">
      <div class="split__copy">
        <h2 id="sell-h">Sell</h2>
        <p>A counter point of sale that keeps up with a queue, and doesn't stop when the internet does.</p>
        <ul class="ticks">{sell.map((x) => <li data-types={x.types.join(' ')}>{x.t}{tags(x.types).length > 0 && <span class="ftags">{tags(x.types).map((n) => <span>{n}</span>)}</span>}</li>)}</ul>
      </div>
      <div class="split__visual sell-pair">
        <Monitor label="The ZapTill point of sale at a demo minimart">
          <Shot src="/screens/till-shop.webp" eager width={1280} height={800}
            alt="The real ZapTill point of sale at a demo minimart: departments as big tabs (All, Groceries, Beverages, Personal care), and a bill of milk, bread, maize flour, eggs and 0.640 kg of beef, total KES 1,246." />
        </Monitor>
        <figure class="sell-pair__inset">
          <Shot src="/screens/till-pos.webp" width={1280} height={800}
            alt="The same point of sale at a demo restaurant: menu buttons and Table 4's order with Chips Masala and Chicken Burger marked Spice: Spicy, total KES 3,050." />
          <figcaption>The same point of sale, at a restaurant</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Barcodes and labels -->
  <section class="band band--white feat" id="labels" data-group aria-labelledby="labels-h">
    <div class="wrap">
      <div class="split split--top">
        <div class="split__copy">
          <h2 id="labels-h">Barcodes and labels</h2>
          <p>Every product scannable, on whatever printer you have.</p>
          <ul class="ticks">{labels.map((x) => <li data-types={x.types.join(' ')}>{x.t}{tags(x.types).length > 0 && <span class="ftags">{tags(x.types).map((n) => <span>{n}</span>)}</span>}</li>)}</ul>
          <p class="feat__note">Printing labels from the point of sale comes with ZapTill Online. When a price changes, print the label again.</p>
        </div>
        <div class="split__visual">
          <LabelSamples />
          <p class="feat__note">Drawn by ZapTill's own label code, for Kijani Basket (a fictional demo minimart).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stock and suppliers -->
  <section class="band feat" id="stock" data-group aria-labelledby="stock-h">
    <div class="wrap split split--flip">
      <div class="split__copy">
        <h2 id="stock-h">Stock and suppliers</h2>
        <p>What came in, what went out, and what went in the bin, in shillings.</p>
        <ul class="ticks">{stock.map((x) => <li data-types={x.types.join(' ')}>{x.t}{tags(x.types).length > 0 && <span class="ftags">{tags(x.types).map((n) => <span>{n}</span>)}</span>}</li>)}</ul>
        <p class="feat__note">Stock at the point of sale, and checking other branches from the point of sale, come with ZapTill Online.</p>
      </div>
      <div class="split__visual">
        <Laptop label="Receiving a delivery and writing off wastage">
          <StockScreen />
        </Laptop>
      </div>
    </div>
  </section>

  <!-- Kitchen -->
  <section class="band band--white feat" id="kitchen" data-group aria-labelledby="kitchen-h">
    <div class="wrap split">
      <div class="split__copy">
        <h2 id="kitchen-h">Kitchen</h2>
        <p>For restaurants, cafés and bars: the order reaches the right cook the moment it's taken.</p>
        <ul class="ticks">{kitchen.map((x) => <li data-types={x.types.join(' ')}>{x.t}{tags(x.types).length > 0 && <span class="ftags">{tags(x.types).map((n) => <span>{n}</span>)}</span>}</li>)}</ul>
      </div>
      <div class="split__visual slips-pair">
        <Receipt kind="kitchen" paper={58} />
        <Receipt kind="extras" paper={58} />
      </div>
    </div>
  </section>

  <!-- Pumps and fuel -->
  <section class="band feat" id="fuel" data-group aria-labelledby="fuel-h">
    <div class="wrap split split--flip">
      <div class="split__copy">
        <h2 id="fuel-h">Pumps and fuel</h2>
        <p>For petrol stations: every litre on a pump, every pump on the point of sale.</p>
        <ul class="ticks">{fuel.map((x) => <li data-types={x.types.join(' ')}>{x.t}{tags(x.types).length > 0 && <span class="ftags">{tags(x.types).map((n) => <span>{n}</span>)}</span>}</li>)}</ul>
        <p class="feat__note">Not yet: pump meter readings and tank dips; tank levels are worked out from deliveries and
          sales. <a href="/for/petrol-stations/">ZapTill for petrol stations</a></p>
      </div>
      <div class="split__visual">
        <Monitor label="The ZapTill point of sale at a demo petrol station">
          <Shot src="/screens/till-pumps.webp" width={1280} height={800}
            alt="The real ZapTill point of sale at a demo petrol station: five pumps with their grade and price a litre, and a sale of 11.66 litres of diesel for KES 2,000 with engine oil and water, total KES 2,920." />
        </Monitor>
      </div>
    </div>
  </section>

  <!-- Parking -->
  <section class="band band--white feat" id="parking" data-group aria-labelledby="parking-h">
    <div class="wrap split">
      <div class="split__copy">
        <h2 id="parking-h">Parking</h2>
        <p>For car parks: every bay, every plate, every hour charged.</p>
        <ul class="ticks">{parking.map((x) => <li data-types={x.types.join(' ')}>{x.t}{tags(x.types).length > 0 && <span class="ftags">{tags(x.types).map((n) => <span>{n}</span>)}</span>}</li>)}</ul>
        <p class="feat__note">Parking runs on the web POS, so it needs the internet. No entry tickets, plate cameras or
          barriers. <a href="/for/parking/">ZapTill for car parks</a></p>
      </div>
      <div class="split__visual icon-panel" aria-hidden="true">
        <svg viewBox="0 0 240 160" class="icon-art">
          <rect x="20" y="20" width="200" height="120" rx="14" fill="#0b2529" stroke="#1d3c40" stroke-width="2" />
          <rect x="44" y="40" width="44" height="80" rx="6" fill="none" stroke="#2dd4bf" stroke-width="4" />
          <rect x="98" y="40" width="44" height="80" rx="6" fill="rgba(252,211,77,0.15)" stroke="#fcd34d" stroke-width="4" />
          <rect x="152" y="40" width="44" height="80" rx="6" fill="none" stroke="#2dd4bf" stroke-width="4" />
          <path d="M112 92V66h10a8 8 0 0 1 0 16h-10" fill="none" stroke="#fcd34d" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Money and day close -->
  <section class="band band--night feat" id="money" data-group aria-labelledby="money-h">
    <div class="wrap split split--flip">
      <div class="split__copy">
        <h2 id="money-h">Money and day close</h2>
        <p>Know at every close whose drawer is short, by how much, before anyone goes home.</p>
        <ul class="ticks">{money.map((x) => <li data-types={x.types.join(' ')}>{x.t}{tags(x.types).length > 0 && <span class="ftags">{tags(x.types).map((n) => <span>{n}</span>)}</span>}</li>)}</ul>
      </div>
      <div class="split__visual money-pair">
        <figure class="screen-crop">
          <Shot src="/screens/till-shifts.webp" width={1200} height={253}
            alt="The real ZapTill shift report: Wanjiru's drawer expected KES 14,550, counted KES 14,200, difference KES -350; Otieno's drawer exact. Both awaiting a manager." />
        </figure>
        <Receipt kind="shop" paper={58} class="money-pair__slip" />
      </div>
    </div>
  </section>

  <!-- Staff and roles -->
  <section class="band feat" id="staff" data-group aria-labelledby="staff-h">
    <div class="wrap">
      <div class="split split--top">
        <div class="split__copy">
          <h2 id="staff-h">Staff and roles</h2>
          <p>Everyone gets their own PIN, and each role sees only what it should.</p>
          <ul class="ticks">{staff.map((x) => <li data-types={x.types.join(' ')}>{x.t}</li>)}</ul>
          <p class="feat__note">Waiter, Kitchen and Kitchen Manager are set up for restaurants and cafés; Fuel attendant
            for petrol stations.</p>
        </div>
        <div class="split__visual">
          <ul class="roles" aria-label="The ready-made roles">
            {ROLES.map((r) => (
              <li class:list={{ 'roles--petrol': r.petrol || r.food }}>
                <b>{r.name}</b>
                <span>{r.does}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Branches and branding -->
  <section class="band band--white feat" id="branches" data-group aria-labelledby="branches-h">
    <div class="wrap split">
      <div class="split__copy">
        <h2 id="branches-h">Branches and branding</h2>
        <p>Run every branch from one place, even when you're not there.</p>
        <ul class="ticks">{branches.map((x) => <li data-types={x.types.join(' ')}>{x.t}{tags(x.types).length > 0 && <span class="ftags">{tags(x.types).map((n) => <span>{n}</span>)}</span>}</li>)}</ul>
      </div>
      <div class="split__visual">
        <Laptop label="The day close on the web dashboard">
          <DayCloseScreen />
        </Laptop>
      </div>
    </div>
  </section>

  <!-- Analytics -->
  <section class="band feat" id="analytics" data-group aria-labelledby="analytics-h">
    <div class="wrap split split--flip">
      <div class="split__copy">
        <h2 id="analytics-h">Analytics</h2>
        <p>An add-on that turns your sales into a short list of what to do next, in your trade's own words.</p>
        <ul class="ticks">{analytics.map((x) => <li data-types={x.types.join(' ')}>{x.t}{tags(x.types).length > 0 && <span class="ftags">{tags(x.types).map((n) => <span>{n}</span>)}</span>}</li>)}</ul>
        <p><a href="/analytics/">See Analytics for a restaurant, a shop or a petrol station</a></p>
      </div>
      <div class="split__visual">
        <DoThisNextCard {...shopCard} who="a demo minimart" />
      </div>
    </div>
  </section>

  <!-- Support and updates -->
  <section class="band band--white feat" id="support" data-group aria-labelledby="support-h">
    <div class="wrap split">
      <div class="split__copy">
        <h2 id="support-h">Support and updates</h2>
        <p>We set it up with you, and most problems are fixed without anyone driving to your place.</p>
        <ul class="ticks">{support.map((x) => <li data-types={x.types.join(' ')}>{x.t}{tags(x.types).length > 0 && <span class="ftags">{tags(x.types).map((n) => <span>{n}</span>)}</span>}</li>)}</ul>
      </div>
      <div class="split__visual icon-panel" aria-hidden="true">
        <svg viewBox="0 0 240 160" class="icon-art">
          <rect x="20" y="20" width="200" height="120" rx="14" fill="#0b2529" stroke="#1d3c40" stroke-width="2" />
          <path d="M120 48v44m0 0l-18-18m18 18l18-18" fill="none" stroke="#2dd4bf" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
          <rect x="84" y="104" width="72" height="8" rx="4" fill="#2dd4bf" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Works offline -->
  <section class="band band--night feat" id="offline" data-group aria-labelledby="offline-h">
    <div class="wrap split split--flip">
      <div class="split__copy">
        <h2 id="offline-h">Works offline</h2>
        <p>When the internet goes, your points of sale don't.</p>
        <ul class="ticks">{offline.map((x) => <li data-types={x.types.join(' ')}>{x.t}{tags(x.types).length > 0 && <span class="ftags">{tags(x.types).map((n) => <span>{n}</span>)}</span>}</li>)}</ul>
        <p class="feat__note">Parking bays run on the web POS and need the internet.</p>
        <p><a href="/#offline">Read the busiest hour with no internet</a></p>
      </div>
      <div class="split__visual icon-panel" aria-hidden="true">
        <svg viewBox="0 0 240 160" class="icon-art">
          <rect x="20" y="20" width="200" height="120" rx="14" fill="#0b2529" stroke="#1d3c40" stroke-width="2" />
          <path d="M70 78a70 70 0 0 1 100 0M86 94a46 46 0 0 1 68 0M104 110a20 20 0 0 1 32 0" fill="none" stroke="#9fb7b5" stroke-width="7" stroke-linecap="round" />
          <path d="M66 46l108 76" stroke="#fcd34d" stroke-width="7" stroke-linecap="round" />
          <circle cx="120" cy="124" r="6" fill="#2dd4bf" />
        </svg>
      </div>
    </div>
  </section>

