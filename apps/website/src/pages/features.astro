---
import Base from '../layouts/Base.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import VisitButton from '../components/VisitButton.astro';
import Monitor from '../components/frames/Monitor.astro';
import Laptop from '../components/frames/Laptop.astro';
import Shot from '../components/screens/Shot.astro';
import Receipt from '../components/screens/Receipt.astro';
import StockScreen from '../components/screens/StockScreen.astro';
import DayCloseScreen from '../components/screens/DayCloseScreen.astro';
import DoThisNextCard from '../components/screens/DoThisNextCard.astro';
import { WA_MESSAGES } from '../lib/site';
import { ROLES } from '../lib/roles';
import { softwareApplication } from '../lib/schema';

// Public scope (owner, 2026-11-13): this page lists only the tested restaurant/hotel POS features — restaurants, cafés,
// bars and quick service. The shop/petrol/parking features live in the code but are parked off the public site. Only
// what ships (WORKPLAN §3). Roles are filtered to the food-service ones (the Fuel attendant is parked with the rest).
const description =
  'Every ZapTill POS feature for restaurants, cafés and bars in Kenya: M-Pesa, menus and tables, orders to the kitchen, stock and recipes, the day close and branches.';

const sell = [
  'Your menu as big buttons, with big tabs across the top: Food, Drinks, Tea',
  'Dine-in with tables, takeaway and delivery from the same screen',
  'Hold an order and pick it up again when the table wants more',
  'Variants and combos on one line: "Chips Masala - Spicy"',
  'Notes for the kitchen, like "No onions"',
  'Split a bill between cash, M-Pesa and card',
  'Sales on account for regulars, within the credit limit you set, confirmed by a manager',
  'When a dish is off, you choose: keep selling, show it as sold out, or hide it until it is back',
  'A menu by the hour: breakfast only in the morning, alcohol only in your licensed hours',
  'Discounts and tips, for the staff you allow',
  'Reprint a receipt when a customer asks',
];
const stock = [
  'Stock levels for every product, and every ingredient in the kitchen',
  'Deliveries received against the supplier\'s note',
  'Supplier bills and what you still owe each supplier',
  'Stock counts, and the difference against what the system expected',
  'Wastage and expired goods written off with a reason and their cost',
  'Transfers between branches, sent by one and received by the other',
  'See what your other branches hold, and ask one of them to send some',
  'Low stock in the daily email',
  'Recipes, so you know what each dish costs to make',
];
const kitchen = [
  'Kitchen tickets and dispatch (packing) tickets, printed as the order is sent',
  'Each part of the menu to its own station: grill, kitchen, bar or dispatch',
  'Variants on the dish\'s own line: "Chips Masala - Spicy"',
  'Extras and the cashier\'s notes under the dish: "+ Extra Cheese", "** No onions"',
  'Combos list their parts, so every piece is cooked and packed',
  'A kitchen display: each order as a card with a timer, Pending to Ready',
  'Items taken back after they reached the kitchen are recorded, with who approved it',
];
const money = [
  'An opening float counted by each cashier',
  'Drawer counts, with over and short for each cashier',
  'Each cashier\'s takings by payment method: cash, M-Pesa, card',
  'A manager confirms every shift',
  'The cashier\'s own slip shows what they declared, never what was expected',
  'Cash paid out and expenses from the drawer, each with who approved it',
  'Close the day and the branch, from the point of sale or from the web',
  'Your Buy Goods or Paybill number, large on every receipt',
];
const staff = [
  'Ready-made roles, so setting up staff takes minutes',
  'A PIN for each person at the point of sale; every sale and void carries their name',
  'A paid order can only be voided or refunded with a manager\'s PIN',
  'Your partner and your accountant sign in to the web dashboard with their own logins, never yours',
  'Sales and voids by cashier in the reports',
  'The owner sets their own password at the first sign-in',
];
const branches = [
  'Every branch on one web dashboard, side by side or one at a time',
  'Stock in every branch: who has it, and a request to send some',
  'A daily summary email, at the time you choose',
  'Close a branch\'s day from the web',
  'Your logo on the receipt; each branch can have its own colours on the point of sale and its own receipt footer',
  'Add a branch later; it joins the same dashboard, with no second cloud fee',
];
const analytics = [
  '"Do this next": a short, ranked list in plain words: what to order before Friday, what to prep for a busy day, old credit to chase',
  'What sells together, in a restaurant\'s words: a drink with a dish, a side with a main, a combo worth putting on the menu',
  'Your week at a glance: what sells each day and at every hour',
  'Stock between branches: "it sells fast at one branch and slowly at another: consider moving some"',
  'The Watch list: voids, refunds, big discounts, short drawers and sales below the menu price, as warnings to look into',
  'Products that still have no cost, so every margin is complete',
  'Menu engineering: which dishes earn their place',
  'Credit ageing: who owes you, and for how long',
  'It never suggests raising your prices',
];
const support = [
  'Setup on site: your menu loaded, printers and screens set up, your staff trained',
  'Updates install themselves, quietly, when the POS computer starts',
  'Support can pull a point of sale\'s log remotely to see what went wrong',
  'Support from 8 am to 7 pm, and 24 hours a day for priority clients',
  'A "what to do when" help screen on the point of sale, which works with no internet',
  'Reports download to Excel whenever you want them',
];
const offline = [
  'Points of sale keep selling and printing with no internet: the counter and the kitchen tickets',
  'Staff still sign in with their PIN',
  'A branch server keeps every point of sale in the branch in step',
  'Everything catches up by itself when the line is back; nobody types anything in again',
  'The POS computer needs power like any computer; a small UPS keeps it going through a short cut',
];

const groups = [
  { id: 'sell', name: 'Sell' },
  { id: 'stock', name: 'Stock and recipes' },
  { id: 'kitchen', name: 'Kitchen' },
  { id: 'money', name: 'Money and day close' },
  { id: 'staff', name: 'Staff and roles' },
  { id: 'branches', name: 'Branches and branding' },
  { id: 'analytics', name: 'Analytics' },
  { id: 'support', name: 'Support and updates' },
  { id: 'offline', name: 'Works offline' },
];
const roles = ROLES.filter((r) => !r.petrol);
---
<Base
  title="POS features for restaurants, cafés and bars | ZapTill"
  description={description}
  waMessage={WA_MESSAGES.features}
  ogImage="/og/features.png"
  jsonLd={[softwareApplication(description)]}
>
  <section class="page-head feat-head">
    <div class="wrap">
      <h1>Everything it does, for your restaurant</h1>
      <p class="lede">
        ZapTill is a point of sale (POS) for the counter and the kitchen, and a back office on the web that opens on your
        phone. The screens are the real app, on a made-up restaurant.
      </p>
      <nav class="feat-jump" aria-label="Feature groups">
        <ul>{groups.map((g) => <li><a href={`#${g.id}`}>{g.name}</a></li>)}</ul>
      </nav>
    </div>
  </section>

  <!-- Sell -->
  <section class="band feat" id="sell" aria-labelledby="sell-h">
    <div class="wrap split">
      <div class="split__copy">
        <h2 id="sell-h">Sell</h2>
        <p>A counter point of sale that keeps up with a queue, and doesn't stop when the internet does.</p>
        <ul class="ticks">{sell.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="split__visual">
        <Monitor label="The ZapTill point of sale at a demo restaurant">
          <Shot src="/screens/till-pos.webp" eager width={1280} height={800}
            alt="The real ZapTill point of sale at a demo restaurant: menu buttons and Table 4's order with Chips Masala and Chicken Burger marked Spice: Spicy, total KES 3,050." />
        </Monitor>
      </div>
    </div>
  </section>

  <!-- Stock and recipes -->
  <section class="band band--white feat" id="stock" aria-labelledby="stock-h">
    <div class="wrap split split--flip">
      <div class="split__copy">
        <h2 id="stock-h">Stock and recipes</h2>
        <p>What came in, what went out, and what went in the bin, in shillings — down to the ingredient.</p>
        <ul class="ticks">{stock.map((t) => <li>{t}</li>)}</ul>
        <p class="feat__note">Stock at the point of sale, and checking other branches from the point of sale, come with ZapTill Online.</p>
      </div>
      <div class="split__visual">
        <Laptop label="Receiving a delivery and writing off wastage">
          <StockScreen />
        </Laptop>
      </div>
    </div>
  </section>

  <!-- Kitchen -->
  <section class="band feat" id="kitchen" aria-labelledby="kitchen-h">
    <div class="wrap split">
      <div class="split__copy">
        <h2 id="kitchen-h">Kitchen</h2>
        <p>For restaurants, cafés and bars: the order reaches the right cook the moment it's taken.</p>
        <ul class="ticks">{kitchen.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="split__visual slips-pair">
        <Receipt kind="kitchen" paper={58} />
        <Receipt kind="extras" paper={58} />
      </div>
    </div>
  </section>

  <!-- Money and day close -->
  <section class="band band--night feat" id="money" aria-labelledby="money-h">
    <div class="wrap split split--flip">
      <div class="split__copy">
        <h2 id="money-h">Money and day close</h2>
        <p>Know at every close whose drawer is short, by how much, before anyone goes home.</p>
        <ul class="ticks">{money.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="split__visual money-pair">
        <figure class="screen-crop">
          <Shot src="/screens/till-shifts.webp" width={1200} height={253}
            alt="The real ZapTill shift report: Wanjiru's drawer expected KES 14,550, counted KES 14,200, difference KES -350; Otieno's drawer exact. Both awaiting a manager." />
        </figure>
        <Receipt kind="sale" paper={58} class="money-pair__slip" />
      </div>
    </div>
  </section>

  <!-- Staff and roles -->
  <section class="band band--white feat" id="staff" aria-labelledby="staff-h">
    <div class="wrap">
      <div class="split split--top">
        <div class="split__copy">
          <h2 id="staff-h">Staff and roles</h2>
          <p>Everyone gets their own PIN, and each role sees only what it should.</p>
          <ul class="ticks">{staff.map((t) => <li>{t}</li>)}</ul>
          <p class="feat__note">Waiter, Kitchen and Kitchen Manager are set up ready for restaurants and cafés.</p>
        </div>
        <div class="split__visual">
          <ul class="roles" aria-label="The ready-made roles">
            {roles.map((r) => (
              <li class:list={{ 'roles--food': r.food }}>
                <b>{r.name}</b>
                <span>{r.does}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Branches and branding -->
  <section class="band feat" id="branches" aria-labelledby="branches-h">
    <div class="wrap split">
      <div class="split__copy">
        <h2 id="branches-h">Branches and branding</h2>
        <p>Run every branch from one place, even when you're not there.</p>
        <ul class="ticks">{branches.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="split__visual">
        <Laptop label="The day close on the web dashboard">
          <DayCloseScreen />
        </Laptop>
      </div>
    </div>
  </section>

  <!-- Analytics -->
  <section class="band band--white feat" id="analytics" aria-labelledby="analytics-h">
    <div class="wrap split split--flip">
      <div class="split__copy">
        <h2 id="analytics-h">Analytics</h2>
        <p>An add-on that turns your sales into a short list of what to do next, in a restaurant's own words.</p>
        <ul class="ticks">{analytics.map((t) => <li>{t}</li>)}</ul>
        <p><a href="/analytics/">See Analytics for your restaurant</a></p>
      </div>
      <div class="split__visual">
        <DoThisNextCard who="a demo restaurant" />
      </div>
    </div>
  </section>

  <!-- Support and updates -->
  <section class="band feat" id="support" aria-labelledby="support-h">
    <div class="wrap split">
      <div class="split__copy">
        <h2 id="support-h">Support and updates</h2>
        <p>We set it up with you, and most problems are fixed without anyone driving to your place.</p>
        <ul class="ticks">{support.map((t) => <li>{t}</li>)}</ul>
      </div>
      <div class="split__visual icon-panel" aria-hidden="true">
        <svg viewBox="0 0 240 160" class="icon-art">
          <rect x="20" y="20" width="200" height="120" rx="14" fill="#0b2529" stroke="#1d3c40" stroke-width="2" />
          <path d="M120 48v44m0 0l-18-18m18 18l18-18" fill="none" stroke="#2dd4bf" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
          <rect x="84" y="104" width="72" height="8" rx="4" fill="#2dd4bf" />
        </svg>
      </div>
    </div>
  </section>

  <!-- Works offline -->
  <section class="band band--night feat" id="offline" aria-labelledby="offline-h">
    <div class="wrap split split--flip">
      <div class="split__copy">
        <h2 id="offline-h">Works offline</h2>
        <p>When the internet goes, your points of sale don't.</p>
        <ul class="ticks">{offline.map((t) => <li>{t}</li>)}</ul>
        <p><a href="/#offline">Read the busiest hour with no internet</a></p>
      </div>
      <div class="split__visual icon-panel" aria-hidden="true">
        <svg viewBox="0 0 240 160" class="icon-art">
          <rect x="20" y="20" width="200" height="120" rx="14" fill="#0b2529" stroke="#1d3c40" stroke-width="2" />
          <path d="M70 78a70 70 0 0 1 100 0M86 94a46 46 0 0 1 68 0M104 110a20 20 0 0 1 32 0" fill="none" stroke="#9fb7b5" stroke-width="7" stroke-linecap="round" />
          <path d="M66 46l108 76" stroke="#fcd34d" stroke-width="7" stroke-linecap="round" />
          <circle cx="120" cy="124" r="6" fill="#2dd4bf" />
        </svg>
      </div>
    </div>
  </section>

  <section class="band band--white final" aria-labelledby="ffinal-title">
    <div class="wrap">
      <h2 id="ffinal-title">See the parts you need, running on your own menu.</h2>
      <div class="actions">
        <WhatsAppButton message={WA_MESSAGES.features} />
        <VisitButton />
      </div>
      <p class="feat__note">
        Pictures on the point of sale, variants, offers and stock at the point of sale come with ZapTill Online; Analytics is an
        add-on.{' '}
        <a href="/pricing/">Build your quote</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .feat-head { background: var(--card); border-bottom: 1px solid var(--line); }
  .feat-head .lede { margin-bottom: var(--s-5); }
  .feat-jump ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .feat-jump a {
    display: inline-block; padding: 0.35rem 0.8rem; border: 1px solid var(--line-strong); border-radius: var(--r-pill);
    text-decoration: none; color: var(--ink-2); font-weight: 600; font-size: var(--fs-sm);
  }
  .feat-jump a:hover { border-color: var(--teal-strong); color: var(--teal-strong); }

  .feat { scroll-margin-top: 4rem; }
  .feat h2 { font-size: var(--fs-xl); }
  .feat .ticks { margin-bottom: var(--s-5); }
  .feat__note { font-size: var(--fs-sm); color: var(--muted); }
  .band--night .feat__note { color: var(--night-muted); }

  .slips-pair { display: flex; gap: var(--s-4); align-items: flex-start; justify-content: center; }
  .slips-pair :global(.slip-wrap) { flex: 1 1 0; min-width: 0; --slip-fs: 0.8rem; }
  .slips-pair :global(.slip-wrap:last-child) { margin-top: var(--s-6); transform: rotate(1.5deg); }
  @media (max-width: 600px) {
    .slips-pair { flex-direction: column; align-items: center; }
    .slips-pair :global(.slip-wrap) { flex: none; }
    .slips-pair :global(.slip-wrap:last-child) { margin-top: 0; }
  }

  .money-pair { display: grid; gap: var(--s-5); justify-items: end; }
  .money-pair :global(.money-pair__slip) { width: 62%; --slip-fs: 0.8rem; transform: rotate(-1.5deg); margin-right: 5%; }
  @media (max-width: 600px) { .money-pair :global(.money-pair__slip) { width: 100%; margin-right: 0; } }

  .roles { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden; }
  .roles li { background: var(--card); padding: var(--s-3) var(--s-4); display: grid; gap: 0.1rem; }
  .roles b { font: 700 1rem/1.3 var(--font-display); }
  .roles span { color: var(--muted); font-size: var(--fs-sm); line-height: 1.45; }
  .roles .roles--food { background: var(--paper); }
  @media (min-width: 560px) { .roles { grid-template-columns: 1fr 1fr; } }

  .icon-panel { display: flex; justify-content: center; }
  .icon-art { width: 100%; max-width: 260px; height: auto; }

  .final h2 { max-width: 24ch; }
  .final .actions { margin-bottom: var(--s-5); }
</style>
