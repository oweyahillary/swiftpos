---
// "Build your quote" (owner, 2026-11-13): prices are off the public site. Instead of a public number, a client picks
// their setup and we send a tailored quote — setup and extra devices vary per client, and support is a conversation,
// so a self-generated quote fits the model better. The selector carries ONLY their choices into a WhatsApp message
// (never anything typed that is PII — there are no name/phone fields here; they reach us on WhatsApp). The /pricing/
// URL is kept so existing links land here. Re-add prices only when the owner says so.
import Base from '../layouts/Base.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import VisitButton from '../components/VisitButton.astro';
import { WA_MESSAGES } from '../lib/site';

const placeTypes = [
  { value: 'restaurant', label: 'Restaurant or café' },
  { value: 'bar', label: 'Bar or lounge' },
  { value: 'quick-service', label: 'Quick service or takeaway' },
];

const setupItems = [
  { t: 'We install it at your place', d: 'The branch server, the points of sale and the printers, set up on site.' },
  { t: 'Your menu, loaded for you', d: 'Send us your menu or price list in Excel or on paper — we do the typing.' },
  { t: 'Receipts and kitchen tickets', d: 'Receipts at the counter and tickets at the right station in the kitchen.' },
  { t: 'Staff roles and PINs', d: 'Cashiers, waiters, supervisors and managers, each seeing only what they should.' },
  { t: 'Training', d: 'For your cashiers, waiters and managers, on your own menu.' },
  { t: 'Your brand', d: 'Your logo and colours on the point of sale and the receipt, per branch.' },
  { t: 'The first day close, together', d: 'We stay for it, so the first one is right.' },
];
---
<Base
  title="Get a ZapTill quote for your restaurant | ZapTill"
  description="Tell us your setup — branches, points of sale and kitchen screens — and we'll send you a tailored quote for your restaurant, café or bar in Kenya."
  waMessage={WA_MESSAGES.pricing}
  ogImage="/og/pricing.png"
>
  <section class="page-head quote-head">
    <div class="wrap">
      <h1>A quote built for your restaurant.</h1>
      <p class="lede">
        Every place is different — the number of branches, how many screens take orders, the kitchen. So instead of a
        one-size-fits-all price, tell us your setup and we'll send you a tailored quote, and talk you through it. No
        obligation.
      </p>
    </div>
  </section>

  <section class="band band--tight" aria-labelledby="quote-title">
    <div class="wrap">
      <form class="quote" data-quote aria-labelledby="quote-title">
        <h2 id="quote-title">Build your quote</h2>
        <p class="quote__lede">A few quick numbers. We'll do the rest.</p>
        <div class="quote__grid">
          <label>What kind of place is it?
            <select name="type">
              {placeTypes.map((t) => <option value={t.value}>{t.label}</option>)}
            </select>
          </label>
          <label>How many branches?
            <input name="branches" type="number" min="1" max="99" value="1" inputmode="numeric" />
          </label>
          <label>Points of sale (screens that take orders)
            <input name="pos" type="number" min="1" max="99" value="1" inputmode="numeric" />
          </label>
          <label>Kitchen screens
            <input name="kitchen" type="number" min="0" max="99" value="0" inputmode="numeric" />
          </label>
        </div>
        <button class="btn btn--wa" type="submit" data-quote-submit>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M.06 24l1.69-6.16a11.87 11.87 0 01-1.6-5.95A11.9 11.9 0 0112.05 0a11.9 11.9 0 018.41 20.3A11.9 11.9 0 016.2 22.3L.06 24zM6.6 20.1l.37.22a9.87 9.87 0 005.08 1.4 9.9 9.9 0 10-9.9-9.9c0 1.8.48 3.56 1.4 5.1l.24.38-1 3.65 3.81-.85z"/></svg>
          Get my tailored quote on WhatsApp
        </button>
        <p class="quote__note">We'll send your quote and talk through setup and support with you. Nothing is charged here.</p>
      </form>
    </div>
  </section>

  <section class="band band--white" aria-labelledby="setup-title">
    <div class="wrap setup">
      <div class="section-head">
        <h2 id="setup-title">What your branch setup includes</h2>
        <p>Not a download and a password. We come to you and get you selling, in this order.</p>
      </div>
      <ol class="setup__list">
        {setupItems.map((s) => (<li><h3>{s.t}</h3><p>{s.d}</p></li>))}
      </ol>
    </div>
  </section>

  <section class="band band--night" aria-labelledby="nosurprise-title">
    <div class="wrap">
      <div class="section-head"><h2 id="nosurprise-title">No surprises</h2></div>
      <ul class="nosurprise">
        <li><h3>The points of sale are paid for once.</h3><p>Once paid, it's a done deal. No monthly fee for the points of sale themselves.</p></li>
        <li><h3>No percentage of your sales.</h3><p>Sell more and your quote stays the same.</p></li>
        <li><h3>The cloud is month to month.</h3><p>One fee for the whole business, not per branch — and the first month is free, so you see it working before you pay.</p></li>
        <li><h3>M-Pesa charges are Safaricom's.</h3><p>We don't add anything on top.</p></li>
        <li><h3>Hardware is separate.</h3><p>We quote it, or you bring your own and we check it.</p></li>
        <li><h3>Your data is yours.</h3><p>Download your reports whenever you want them.</p></li>
      </ul>
    </div>
  </section>

  <section class="band band--white final" aria-labelledby="pfinal-title">
    <div class="wrap">
      <h2 id="pfinal-title">Tell us about your place. We'll send you a quote today.</h2>
      <div class="actions">
        <WhatsAppButton message={WA_MESSAGES.pricing} />
        <VisitButton label="See it running near you" />
      </div>
    </div>
  </section>
</Base>

<script>
  import { waLink } from '../lib/site';
  const LABELS: Record<string, string> = {
    restaurant: 'Restaurant or café', bar: 'Bar or lounge', 'quick-service': 'Quick service or takeaway',
  };
  const clamp = (v: FormDataEntryValue | null, min: number) => Math.max(min, Math.min(99, parseInt(String(v ?? '')) || min));
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-quote]')) {
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const f = new FormData(form);
      const type = LABELS[String(f.get('type'))] ?? 'Restaurant or café';
      const branches = clamp(f.get('branches'), 1);
      const pos = clamp(f.get('pos'), 1);
      const kitchen = clamp(f.get('kitchen'), 0);
      const msg = `Hi ZapTill, I'd like a tailored quote.\n\n• ${type}\n• Branches: ${branches}\n• Points of sale: ${pos}\n• Kitchen screens: ${kitchen}\n\nPlease send me a quote.`;
      window.open(waLink(msg), '_blank', 'noopener');
    });
  }
</script>

<style>
  .quote-head { background: var(--card); border-bottom: 1px solid var(--line); }
  .quote-head h1 { margin-top: var(--s-5); }
  .quote-head .lede { margin-bottom: var(--s-5); max-width: 42rem; }

  .quote { background: var(--card); border: 1px solid var(--line); border-radius: var(--r-lg); padding: var(--s-5); max-width: 46rem; }
  .quote h2 { font-size: var(--fs-xl); }
  .quote__lede { color: var(--ink-2); margin-top: var(--s-1); }
  .quote__grid { display: grid; gap: var(--s-4); margin: var(--s-5) 0; }
  .quote label { display: grid; gap: 0.35rem; font-weight: 600; font-size: var(--fs-sm); }
  .quote select, .quote input {
    font: inherit; font-weight: 400; font-size: 1rem; padding: 0.65rem 0.75rem; border: 1px solid var(--line-strong);
    border-radius: var(--r-md); background: #fff; color: var(--ink); width: 100%; min-width: 0;
  }
  .quote .btn--wa { display: inline-flex; align-items: center; gap: 0.5rem; }
  .quote__note { color: var(--muted); font-size: var(--fs-sm); margin-top: var(--s-3); }
  @media (min-width: 560px) { .quote__grid { grid-template-columns: 1fr 1fr; } }

  .setup__list { list-style: none; counter-reset: step; margin: 0; padding: 0; display: grid; gap: var(--s-1); max-width: 52rem; }
  .setup__list li {
    counter-increment: step; display: grid; grid-template-columns: 2.5rem 1fr; column-gap: var(--s-4);
    padding: var(--s-4) 0; border-bottom: 1px solid var(--line);
  }
  .setup__list li::before {
    content: counter(step); grid-row: span 2; display: grid; place-items: center;
    width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--teal-wash); color: var(--teal-deep); font: 700 1rem/1 var(--font-display);
  }
  .setup__list h3 { margin: 0.35rem 0 var(--s-1); }
  .setup__list p { margin: 0; color: var(--ink-2); }

  .nosurprise { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-5); }
  .nosurprise li { border-top: 2px solid var(--teal); padding-top: var(--s-4); }
  .nosurprise h3 { color: #fff; margin-bottom: var(--s-2); }
  .nosurprise p { color: var(--night-muted); margin: 0; }
  @media (min-width: 760px) { .nosurprise { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .nosurprise { grid-template-columns: repeat(3, 1fr); } }

  .final h2 { max-width: 24ch; }
</style>
