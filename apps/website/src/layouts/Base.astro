---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import { organization } from '../lib/schema';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  /** The pre-filled WhatsApp message for the header button on this page. */
  waMessage?: string;
  /** A page's own Open Graph card (public/og/<page>.png, made by scripts/make-og.mjs); else the default card. */
  ogImage?: string;
  /** schema.org objects for this page (SoftwareApplication, FAQPage…). The Organization is added on every page. */
  jsonLd?: object[];
  /** Keep this page out of search engines (a guide still in draft, night 3). */
  noindex?: boolean;
}

const { title, description, waMessage, ogImage = '/og-zaptill.png', jsonLd = [], noindex = false } = Astro.props;
// JSON embedded in a script tag; the opening angle bracket is escaped so nothing we write can close the tag early.
const ld = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImageUrl = new URL(ogImage, Astro.site ?? SITE.url).href;
---
<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#061a1d" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZapTill" />
    <meta property="og:locale" content="en_KE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={ld(organization())} />
    {jsonLd.map((o) => <script type="application/ld+json" set:html={ld(o)} />)}

    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Silky page-to-page transitions (Astro View Transitions). -->
    <ClientRouter />
    <!-- Motion flag set BEFORE first paint, so reveal elements start hidden (no flash). Skipped for a visitor who asked
         for reduced motion, and with JS off: in both cases every element simply stays visible. -->
    <script is:inline>
      if (!window.matchMedia || !matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('motion');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header waMessage={waMessage} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <!-- Reveal elements as they scroll into view. Re-runs on every Astro view transition (astro:page-load fires on the
         first load and after each client-side navigation). A no-op under reduced motion or no-JS: content is already shown. -->
    <script>
      function setupReveal() {
        if (!document.documentElement.classList.contains('motion')) return;
        const io = new IntersectionObserver((entries, obs) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });
        document.querySelectorAll('.reveal:not(.is-in), .wipe:not(.is-in), .draw-line:not(.is-in)').forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', setupReveal);
    </script>
  </body>
</html>
