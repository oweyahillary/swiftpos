{
  "name": "zaptill-android",
  "version": "0.3.1",
  "private": true,
  "description": "ZapTill for Android: one Capacitor app, two modes (Shop POS / Owner or manager phone). docs/ANDROID-APP-DESIGN.md",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc --noEmit && vite build",
    "type-check": "tsc --noEmit",
    "sync": "npm run build && cap sync android",
    "apk:debug": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@zaptill/core": "file:../../packages/core",
    "@zaptill/ui": "file:../../packages/ui",
    "bcryptjs": "2.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/bcryptjs": "2.4.6",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=24"
  }
}
